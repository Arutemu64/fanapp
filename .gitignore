# Python cache and virtualenvs
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyre/
.hypothesis/
.coverage
.coverage.*
htmlcov/
dist/
build/

# Local environment files
**/.env
**/.env.*
!.env.example
!**/.env.example
!.env.test
!**/.env.test

# Local secrets (VAPID PEM keys etc.) live in secrets/. That dir is kept in
# the repo (empty) via its own secrets/.gitignore, which ignores everything
# inside except itself — so no secret is ever accidentally committed.

# Local tools and scratch files
/etc/
*.log

# Editor settings
.idea/
*.iml
*.iws
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
# VS Code reads extensions.json and mcp.json only from the workspace-folder
# root, so these two must live here rather than under frontend/ to have any
# effect when the monorepo root is opened. The pattern above is anchored to
# this file, which is why a nested frontend/.vscode/ escaped it and the files
# ended up there — shared editor config is not per-package.
!.vscode/extensions.json
!.vscode/mcp.json

# OS files
.DS_Store
Thumbs.db
# CocoIndex Code (ccc)
/.cocoindex_code/
