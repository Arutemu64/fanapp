{
	servers {
        # Set trusted proxies so passing HTTPS handled correctly
		trusted_proxies static 100.64.0.0/10
	}
}

# The upstream ports below must match the host ports Compose publishes
# (API_PORT / FRONTEND_PORT in .env, default 8000 / 3000). If you override
# either var, update the matching reverse_proxy target here.
:80 {
    # Compress JSON/text responses for both the API and the SPA shell.
    # (Static frontend assets are already gzipped by frontend/nginx.conf;
    # re-encoding them here again is a harmless no-op, not a correctness
    # issue.) Exclude the SSE stream: encode buffers each chunk before
    # flushing, which breaks real-time delivery and can drop the tail of
    # the last event (caddyserver/caddy#6293). The header-flush fix
    # (caddyserver/caddy#7905) has landed on master but isn't in a stable
    # release yet — and even once it is, compressing small, frequent SSE
    # frames buys little, so keep the exclusion.
	@compressible {
		not path /api/events*
	}
	encode @compressible zstd gzip

    # Route all requests starting with /api to FastAPI
	handle_path /api* {
		reverse_proxy http://127.0.0.1:8000
	}

    # Route everything else to Svelte/Vite
	handle {
		reverse_proxy http://127.0.0.1:3000
	}
}
