{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Backend: FastAPI (fanfan.main.web)",
			"type": "debugpy",
			"request": "launch",
			"module": "fanfan.main.web",
			"cwd": "${workspaceFolder}/backend",
			// Resolves to the interpreter the Python extension has selected for the
			// workspace (seeded from python.defaultInterpreterPath in settings.json
			// on first load) rather than a hardcoded POSIX path, so this config also
			// works when that interpreter is backend/.venv/Scripts/python.exe on Windows.
			"python": "${command:python.interpreterPath}",
			// The root .env, the one `just bootstrap` writes — there is no
			// backend/.env. Matches env_file=".env" in adapters/config/models.py,
			// which the backend resolves by walking up from backend/.
			"envFile": "${workspaceFolder}/.env",
			"console": "integratedTerminal",
			"justMyCode": true
		},
		{
			"name": "Frontend: SvelteKit (pnpm dev)",
			"type": "node-terminal",
			"request": "launch",
			"command": "pnpm dev",
			"cwd": "${workspaceFolder}/frontend"
		}
	],
	"compounds": [
		{
			"name": "Dev: Backend + Frontend",
			"configurations": [
				"Backend: FastAPI (fanfan.main.web)",
				"Frontend: SvelteKit (pnpm dev)"
			]
		}
	]
}
