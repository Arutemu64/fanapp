# Root `.env` template — used by Docker Compose for all services (backend + frontend).
# Copy to `.env` and replace all placeholders before running the app.
# For local development without Docker, also copy `frontend/.env.example` → `frontend/.env`.

# -----------------------------------------------------------------------------
# General settings
# -----------------------------------------------------------------------------
ENV=dev
TIMEZONE=Europe/Moscow

# Image tag pulled by `just deploy` / docker-compose.prod.yml on the server.
# Leave unset to track the latest `main` build; pin a specific build for a
# reproducible deploy or rollback, e.g. IMAGE_TAG=sha-1a2b3c4.
# IMAGE_TAG=latest

# -----------------------------------------------------------------------------
# Web / API
# `WEB__BASE_URL` must end with `/` because the backend builds
# email verification and magic link URLs from this value.
# `WEB__HOST` / `WEB__PORT` define where the backend listens for requests.
# -----------------------------------------------------------------------------
WEB__HOST=0.0.0.0
WEB__PORT=8000
WEB__BASE_URL=http://localhost:3000/
WEB__SECRET_KEY=change-me-long-random-string
# Use False for local HTTP development and True only behind HTTPS.
WEB__COOKIE_SECURE=False
# Browser origins allowed to call the API with credentials (JSON array).
# Leave unset to default to the WEB__BASE_URL origin. Add extra origins for
# multi-domain setups, e.g. WEB__CORS_ALLOW_ORIGINS=["https://app.example.com"].
# Never use "*": requests carry the session cookie.
# WEB__CORS_ALLOW_ORIGINS=["http://localhost:3000"]

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
DB__HOST=db
DB__PORT=5432
DB__USER=fanfan
DB__PASSWORD=change-me-db-password
DB__NAME=fanfan
DB__ECHO=False

# -----------------------------------------------------------------------------
# Redis
# Password is required because Docker Compose starts Redis with `--requirepass`.
# -----------------------------------------------------------------------------
REDIS__HOST=redis
REDIS__PORT=6379
REDIS__PASSWORD=change-me-redis-password
REDIS__DATABASE=0

# -----------------------------------------------------------------------------
# NATS
# -----------------------------------------------------------------------------
NATS__HOST=nats
NATS__PORT=4222
NATS__USER=fanfan
NATS__PASSWORD=change-me-nats-password

# -----------------------------------------------------------------------------
# Debug and observability
# `DEBUG__LOGGING_LEVEL=10` means DEBUG level.
# Leave `DEBUG__SENTRY_DSN` empty if Sentry (GlitchTip) is not used.
# `DEBUG__SENTRY_TRACES_SAMPLE_RATE` controls performance trace volume (0.0–1.0).
# `DEBUG__SENTRY_PROFILES_SAMPLE_RATE` enables Python profiling (0.0–1.0).
# -----------------------------------------------------------------------------
DEBUG__ENABLED=True
DEBUG__TEST_MODE=False
DEBUG__LOGGING_LEVEL=10
DEBUG__JSON_LOGS=False
DEBUG__SENTRY_DSN=
DEBUG__SENTRY_TRACES_SAMPLE_RATE=0.1
DEBUG__SENTRY_PROFILES_SAMPLE_RATE=0.0
# Sentry auth token for uploading frontend source maps at build time.
# Generate at https://sentry.io/settings/account/api/auth-tokens/
DEBUG__SENTRY_AUTH_TOKEN=

# -----------------------------------------------------------------------------
# SMTP mail
# Sender format: Name <noreply@example.com>
# -----------------------------------------------------------------------------
MAIL__USERNAME=your-smtp-username
MAIL__PASSWORD=your-smtp-password
MAIL__HOST=sandbox.smtp.mailtrap.io
MAIL__PORT=2525
MAIL__SENDER=ФАН ФАН <noreply@fancom.info>

# -----------------------------------------------------------------------------
# Web Push / VAPID
# Generate PEM keys with `vapid-gen`.
# Note: For Docker, these paths are explicitly overridden in `docker-compose.yml`.
# The paths below are used for local execution.
# -----------------------------------------------------------------------------
PUSH__PRIVATE_KEY_PATH=config/private_key.pem
PUSH__PUBLIC_KEY_PATH=config/public_key.pem
PUSH__SUBSCRIBER=your-email@example.com

# -----------------------------------------------------------------------------
# Telegram bot
# -----------------------------------------------------------------------------
BOT__TOKEN=1234567890:replace-with-bot-token
BOT__CLIENT_ID=1234567890
BOT__CLIENT_SECRET=replace-with-client-secret

# -----------------------------------------------------------------------------
# Optional external integrations
# Uncomment and fill these only if you actually use these services.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Frontend (SvelteKit)
# PUBLIC_* vars are exposed to the browser. PRIVATE_API_URL is server-only
# and is hardcoded to the internal Docker network in docker-compose.yml.
# -----------------------------------------------------------------------------
# Public-facing API base URL. In production this MUST be the same origin
# (scheme + host) as the site, with the `/api` path that Caddy routes to the
# backend — e.g. https://example.com/api. Keeping it same-origin means the
# browser and SSR both treat API calls as same-origin, so no CORS is involved.
# A different scheme/host here (e.g. http:// while the site is https://) makes
# SvelteKit simulate CORS during SSR and fail. See docs/gotchas.md.
PUBLIC_API_URL=http://localhost:8000
# VAPID public key for Web Push (must match PUSH__PUBLIC_KEY_PATH content)
PUBLIC_VAPID_KEY=
# Sentry DSN for frontend error tracking (leave empty to disable)
PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
# Cloudflare Turnstile site key for the login captcha (leave empty to disable).
# Must be paired with the backend secret key TURNSTILE__SECRET_KEY below.
PUBLIC_TURNSTILE_SITE_KEY=

# -----------------------------------------------------------------------------
# Optional external integrations
# Uncomment and fill these only if you actually use these services.
# -----------------------------------------------------------------------------

## Cloudflare Turnstile (login captcha)
# Captcha is enabled only when BOTH keys below are set (secret here, site key
# in PUBLIC_TURNSTILE_SITE_KEY above). Leave them empty to disable the captcha.
# TURNSTILE__SECRET_KEY=replace-with-turnstile-secret-key

## TicketsCloud
# TCLOUD__API_KEY=replace-with-tcloud-api-key
# TCLOUD__EVENT_IDS_MAP={"event-id-participant":"participant","event-id-visitor":"visitor"}

## Cosplay2
# COSPLAY2__EVENT_ID=1234
# COSPLAY2__SUBDOMAIN=your-event-subdomain
# COSPLAY2__API_KEY=replace-with-cosplay2-api-key
# COSPLAY2__API_SECRET=replace-with-cosplay2-api-secret

# -----------------------------------------------------------------------------
# Scheduler (periodic sync jobs)
# Cron expressions, evaluated in the app timezone (TIMEZONE).
# Unset = job disabled. Set a cron to enable, then restart the scheduler:
#   docker compose restart scheduler
# -----------------------------------------------------------------------------
# SCHEDULER__SYNC_TCLOUD_CRON="0 * * * *"
# SCHEDULER__SYNC_COSPLAY2_CRON="*/15 * * * *"
# Outbox retention purge (delivered rows older than OUTBOX__RETENTION_DAYS).
# SCHEDULER__OUTBOX_RETENTION_CRON="0 4 * * *"

# -----------------------------------------------------------------------------
# Transactional outbox relay (delivers aggregate domain events to NATS).
# Runs inside the scheduler on an interval; defaults are sensible — override
# only to tune throughput/latency.
# -----------------------------------------------------------------------------
# OUTBOX__POLL_INTERVAL_SECONDS=2.0
# OUTBOX__BATCH_SIZE=100
# OUTBOX__RETENTION_DAYS=7
