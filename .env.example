APP_ENV=dev
TIMEZONE=Europe/Moscow

WEB__HOST=0.0.0.0
WEB__PORT=8000
WEB__PUBLIC_URL=http://localhost:3000/
WEB__SECRET_KEY=change-me-long-random-string
WEB__COOKIE_SECURE=False
# Local login uses email codes from the API logs. Enable OAuth only with real credentials.
WEB__ENABLED_OAUTH_PROVIDERS=[]

DB__HOST=localhost
DB__PORT=5432
DB__USER=fanfan
DB__PASSWORD=change-me-db-password
DB__NAME=fanfan

NATS__HOST=localhost
NATS__PORT=4222
NATS__USER=fanfan
NATS__PASSWORD=change-me-nats-password

BOT__TOKEN=1234567890:replace-with-bot-token
BOT__CLIENT_ID=1234567890
BOT__CLIENT_SECRET=replace-with-client-secret

VK__CLIENT_ID=your-vk-app-id
VK__CLIENT_SECRET=your-vk-protected-key
VK__GROUP_TOKEN=your-vk-group-token
# Numeric community id, the same as PUBLIC_VK_GROUP_ID.
VK__GROUP_ID=1

PUSH__PRIVATE_KEY_PATH=secrets/private_key.pem
PUSH__PUBLIC_KEY_PATH=secrets/public_key.pem
PUSH__SUBSCRIBER=your-email@example.com

DEBUG__SENTRY_DSN=
DEBUG__SENTRY_AUTH_TOKEN=

ALTCHA__HMAC_KEY=change-me-altcha-hmac-key

# FestEngine webhooks: POST /api/webhooks/festengine. Unset = disabled (404).
# FESTENGINE__WEBHOOK_SECRET=whsec_replace-with-generated-secret

PUBLIC_TIMEZONE=Europe/Moscow
PUBLIC_SITE_URL=http://localhost:3000
PUBLIC_API_URL=/api
PUBLIC_VAPID_KEY=
PUBLIC_VK_GROUP_ID=
# Bot @username without the @, for the t.me link in the Telegram settings dialog.
PUBLIC_TELEGRAM_BOT_USERNAME=
PUBLIC_SENTRY_DSN=
PUBLIC_SENTRY_ENVIRONMENT=production
PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
PUBLIC_UMAMI_SCRIPT_URL=
PUBLIC_UMAMI_WEBSITE_ID=
SENTRY_URL=
SENTRY_ORG=
SENTRY_PROJECT=
