# Root `.env` template — the single source of truth for every variable the app
# needs. Copy to `.env` and replace all placeholders before running the app.
# The frontend reads this same file directly (frontend/svelte.config.js
# `env.dir` + frontend/vite.config.ts `envDir`/`loadEnv` point at the repo
# root), so local `just frontend-dev` needs no separate frontend env file.
#
# ─────────────────────────────────────────────────────────────────────────────
# This file serves THREE consumers. Each variable is grouped under the scope
# that owns it, so it is clear who reads what:
#
#   ▓ SHARED / DOCKER COMPOSE  — orchestration & host settings (flat names).
#   ▓ BACKEND (FastAPI)        — `SECTION__FIELD` nested config (see below).
#   ▓ FRONTEND (SvelteKit)     — `PUBLIC_*` / `VITE_*` build args.
#
# Naming: `SECTION__FIELD` (double underscore) is NOT a typo — it maps to the
# backend's nested pydantic-settings config (env_nested_delimiter="__"), e.g.
# WEB__PORT → web.port. Flat single-underscore names (FRONTEND_PORT, API_PORT,
# IMAGE_TAG, PUBLIC_*, VITE_*) are read by Docker Compose or the frontend build,
# not by that nested config — don't add `__` to them.
#
# The backend reads this same file, so it also sees the Compose/frontend vars;
# it ignores the ones that aren't backend fields (EnvConfig extra="ignore").
#
# KEEP IN SYNC: the BACKEND block mirrors `adapters/config/models.py`. When you
# add/rename/remove a backend config field you MUST update this file too — see
# the config-drift rule in AGENTS.md.

# =============================================================================
# ▓▓▓ SHARED / DOCKER COMPOSE ▓▓▓
# Orchestration & host-level settings. Flat names read by Docker Compose;
# APP_ENV and TIMEZONE are ALSO read by the backend.
# =============================================================================

# Deployment environment: dev | staging | prod. Single source of truth for the
# dev/prod posture. `dev` relaxes the debug defaults below (verbose console logs,
# FastAPI debug mode); `staging`/`prod` keep production-safe defaults. With
# APP_ENV=prod the app refuses to start if DEBUG__ENABLED=True (no traceback
# leaks). Named APP_ENV (not bare ENV) to avoid a stray ambient ENV shadowing it.
APP_ENV=dev
TIMEZONE=Europe/Moscow

# Commit SHA of the running backend build, reported as the Sentry release. The
# publish workflow bakes it into the image (Dockerfile ARG/ENV APP_BUILD), so it
# stays COMMENTED OUT here: `env_file` values are injected into the container and
# override image ENV, meaning an empty APP_BUILD= line would erase the baked-in
# value in production. Uncomment only to override a local build deliberately.
# APP_BUILD=

# Image tag pulled by `just deploy` / docker-compose.prod.yml on the server.
# Leave unset to track the latest `main` build; pin a specific build for a
# reproducible deploy or rollback, e.g. IMAGE_TAG=sha-1a2b3c4.
# IMAGE_TAG=latest

# Which host ports the frontend and API are published on. Only the HOST side is
# remapped — the containers still listen on their fixed internal ports, and
# service-to-service calls use the Compose network. Override these to dodge a
# collision when 3000/8000 are already taken. FRONTEND_PORT also drives the
# vite dev server (with and without Docker; see frontend/vite.config.ts).
# NOTE: the upstream `Caddyfile.example` hardcodes 127.0.0.1:3000 / :8000 — if
# you change these, update the Caddyfile to match.
# FRONTEND_PORT=3000
# API_PORT=8000

# =============================================================================
# ▓▓▓ BACKEND (FastAPI — required) ▓▓▓
# `SECTION__FIELD` nested config, mirroring `adapters/config/models.py`:
# web → db → redis → nats → mail → bot → push → debug → external → scheduler
# → outbox → notification. A few of these (DB__*, NATS__*, REDIS__PASSWORD,
# DEBUG__SENTRY_AUTH_TOKEN) are ALSO read by Docker Compose to seed containers.
#
# SERVICE HOSTNAMES (DB__HOST, REDIS__HOST, NATS__HOST) are set to `localhost`
# here, NOT to the Compose service names. In Docker they are overridden per
# service by the `environment:` block in docker-compose.yml, which outranks
# `env_file:` in Compose's precedence order — so a container always reaches
# `db`/`redis`/`nats` no matter what this file says. That leaves these values
# with exactly one reader: a backend process you run on the host
# (`just backend-dev`, `just backend-migrate`, `just backend-sync`), which
# reaches the containers through their published 127.0.0.1 ports. Point them at
# the Compose names and only the host path breaks — silently, and only for
# whoever tries it.
# =============================================================================

# -----------------------------------------------------------------------------
# Web / API
# `WEB__HOST` / `WEB__PORT` define where the backend process LISTENS.
# `WEB__PUBLIC_URL` is the opposite end: the public origin browsers use to
# reach the app (frontend at `/`, API at `/api`). Behind a reverse proxy the
# app cannot infer it, and it must match the domain your proxy serves —
# email verification, magic link and notification URLs are built from it, so
# a stale value sends users to the wrong host. A missing trailing `/` is
# added automatically.
# -----------------------------------------------------------------------------
WEB__HOST=0.0.0.0
WEB__PORT=8000
WEB__PUBLIC_URL=http://localhost:3000/
WEB__SECRET_KEY=change-me-long-random-string
# Use False for local HTTP development and True only behind HTTPS.
WEB__COOKIE_SECURE=False
# Browser origins allowed to call the API with credentials (JSON array).
# Leave unset to default to the WEB__PUBLIC_URL origin. Add extra origins for
# multi-domain setups, e.g. WEB__CORS_ALLOW_ORIGINS=["https://app.example.com"].
# Never use "*": requests carry the session cookie.
# WEB__CORS_ALLOW_ORIGINS=["http://localhost:3000"]

# -----------------------------------------------------------------------------
# PostgreSQL
# DB__USER / DB__PASSWORD / DB__NAME are also read by Docker Compose to seed the
# Postgres container (POSTGRES_USER/PASSWORD/DB).
# DB__HOST is host-side only — see SERVICE HOSTNAMES in the block header above.
# -----------------------------------------------------------------------------
DB__HOST=localhost
DB__PORT=5432
DB__USER=fanfan
DB__PASSWORD=change-me-db-password
DB__NAME=fanfan
# Log every SQL statement and its bound parameters. Keep False outside local
# debugging — the parameters include emails and password hashes.
DB__ECHO=False
# Connection pool sizing (SQLAlchemy QueuePool). A process opens at most
# DB__POOL_SIZE + DB__MAX_OVERFLOW connections; keep the total across the api,
# faststream and scheduler services under Postgres' max_connections (default 100).
DB__POOL_SIZE=5
DB__MAX_OVERFLOW=10
# Recycle connections older than this many seconds (guards against dropped idle
# connections behind a firewall/NAT).
DB__POOL_RECYCLE=1800
# Server-side safety timeouts in milliseconds; 0 disables an individual timeout.
# They cap runaway queries and transactions left open so a stuck request can't
# pin a pooled connection (and its locks) indefinitely.
DB__STATEMENT_TIMEOUT=30000
DB__LOCK_TIMEOUT=10000
DB__IDLE_IN_TRANSACTION_SESSION_TIMEOUT=60000
# Connection label shown in pg_stat_activity. Left unset here; Docker Compose
# sets a distinct DB__APPLICATION_NAME per service so locks are attributable.
# DB__APPLICATION_NAME=fanfan

# -----------------------------------------------------------------------------
# Redis
# Password is required because Docker Compose starts Redis with `--requirepass`.
# REDIS__HOST is host-side only — see SERVICE HOSTNAMES in the block header above.
# -----------------------------------------------------------------------------
REDIS__HOST=localhost
REDIS__PORT=6379
REDIS__PASSWORD=change-me-redis-password
REDIS__DATABASE=0

# -----------------------------------------------------------------------------
# NATS
# NATS__HOST is host-side only — see SERVICE HOSTNAMES in the block header above.
# -----------------------------------------------------------------------------
NATS__HOST=localhost
NATS__PORT=4222
NATS__USER=fanfan
NATS__PASSWORD=change-me-nats-password

# -----------------------------------------------------------------------------
# SMTP mail (optional)
# Sender format: Name <noreply@example.com>
# Leave the whole block unset to disable email: outgoing emails are then logged
# instead of sent (email login/confirmation codes appear in the app logs — handy
# for local dev). Set all four to enable real sending.
# -----------------------------------------------------------------------------
# MAIL__USERNAME=your-smtp-username
# MAIL__PASSWORD=your-smtp-password
# MAIL__HOST=sandbox.smtp.mailtrap.io
# MAIL__PORT=2525
# MAIL__SENDER=Приложение ФАН ФАН <noreply@fancom.info>

# -----------------------------------------------------------------------------
# Telegram bot
# The placeholder values below are format-valid, so the web API boots with them
# as-is — but Telegram login and Telegram notifications won't work until you set
# a real bot (create one via @BotFather). Email/credentials login still work
# without it. The bot process itself does require a real token to run.
# CLIENT_ID / CLIENT_SECRET come from @BotFather's Bot Settings > Web Login, and
# real credentials alone are not enough: the OAuth callback URLs have to be
# registered on that same screen or Telegram refuses the login. See
# docs/deployment.md "Telegram login: register the URLs with BotFather".
# -----------------------------------------------------------------------------
BOT__TOKEN=1234567890:replace-with-bot-token
BOT__CLIENT_ID=1234567890
BOT__CLIENT_SECRET=replace-with-client-secret

# -----------------------------------------------------------------------------
# Web Push / VAPID
# Generate PEM keys with `vapid-gen`.
# Note: For Docker, these paths are explicitly overridden in `docker-compose.yml`.
# The paths below are used for local execution.
# -----------------------------------------------------------------------------
PUSH__PRIVATE_KEY_PATH=secrets/private_key.pem
PUSH__PUBLIC_KEY_PATH=secrets/public_key.pem
PUSH__SUBSCRIBER=your-email@example.com

# -----------------------------------------------------------------------------
# Debug and observability
# ENABLED / LOGGING_LEVEL / JSON_LOGS are DERIVED from ENV above — leave them
# unset to get the right posture automatically (dev: debug on, DEBUG-level
# console logs; staging/prod: debug off, INFO-level JSON logs). Set one only to
# override that default for the current ENV (an explicit value always wins).
#   DEBUG__ENABLED=False      # FastAPI debug mode (tracebacks) + local reload
#   DEBUG__LOGGING_LEVEL=10   # 10=DEBUG, 20=INFO, 30=WARNING
#   DEBUG__JSON_LOGS=True     # JSON log output (vs human-readable console)
#
# Sentry/GlitchTip: leave DEBUG__SENTRY_DSN empty to disable error reporting.
# TRACES/PROFILES sample rates (0.0–1.0) control perf-trace and profiling volume.
# -----------------------------------------------------------------------------
DEBUG__TEST_MODE=False
DEBUG__SENTRY_DSN=
DEBUG__SENTRY_TRACES_SAMPLE_RATE=0.1
DEBUG__SENTRY_PROFILES_SAMPLE_RATE=0.0
# Sentry auth token for uploading frontend source maps at build time.
# Docker Compose passes it to the frontend image build as a BuildKit secret
# (never a build arg). Generate at
# https://sentry.io/settings/account/api/auth-tokens/
DEBUG__SENTRY_AUTH_TOKEN=

# -----------------------------------------------------------------------------
# Optional external integrations
# Uncomment and fill these only if you actually use these services.
# Order mirrors the backend config model: cosplay2 → tcloud → smartcaptcha.
# -----------------------------------------------------------------------------

## Cosplay2
# COSPLAY2__EVENT_ID=1234
# COSPLAY2__SUBDOMAIN=your-event-subdomain
# COSPLAY2__API_KEY=replace-with-cosplay2-api-key
# COSPLAY2__API_SECRET=replace-with-cosplay2-api-secret

## TicketsCloud
# TCLOUD__API_KEY=replace-with-tcloud-api-key
# TCLOUD__EVENT_IDS_MAP={"event-id-participant":"participant","event-id-visitor":"visitor"}
# Secret path segment for the inbound webhook. Set TicketsCloud to POST to
# /api/webhooks/tcloud/<this-value>. Unset = webhook disabled (returns 404).
# TCLOUD__WEBHOOK_SECRET=replace-with-long-random-token

## Yandex SmartCaptcha (login captcha)
# Captcha is enabled only when BOTH keys are set (server key here, client key in
# PUBLIC_SMARTCAPTCHA_CLIENT_KEY under FRONTEND below). Leave them empty to disable.
# SMARTCAPTCHA__SERVER_KEY=replace-with-smartcaptcha-server-key

# -----------------------------------------------------------------------------
# Scheduler (periodic sync jobs) — optional
# Cron expressions, evaluated in the app timezone (TIMEZONE).
# Unset = job disabled. Set a cron to enable, then restart the scheduler:
#   docker compose restart scheduler
# -----------------------------------------------------------------------------
# SCHEDULER__SYNC_TCLOUD_CRON="0 * * * *"
# SCHEDULER__SYNC_COSPLAY2_CRON="*/15 * * * *"
# Outbox retention purge (delivered rows older than OUTBOX__RETENTION_DAYS).
# SCHEDULER__OUTBOX_RETENTION_CRON="0 4 * * *"
# Notification retention purge (rows older than NOTIFICATION__RETENTION_DAYS).
# SCHEDULER__NOTIFICATION_RETENTION_CRON="0 4 * * *"

# -----------------------------------------------------------------------------
# Transactional outbox relay (delivers aggregate domain events to NATS) — optional
# Runs inside the scheduler on an interval; defaults are sensible — override
# only to tune throughput/latency.
# -----------------------------------------------------------------------------
# OUTBOX__POLL_INTERVAL_SECONDS=2.0
# OUTBOX__BATCH_SIZE=100
# OUTBOX__RETENTION_DAYS=7

# -----------------------------------------------------------------------------
# Notification retention (age before stored notifications are purged) — optional
# Enable the purge via SCHEDULER__NOTIFICATION_RETENTION_CRON above.
# -----------------------------------------------------------------------------
# NOTIFICATION__RETENTION_DAYS=30

# =============================================================================
# ▓▓▓ FRONTEND (SvelteKit static SPA) ▓▓▓
# PUBLIC_* vars are exposed to the browser. The frontend is a static SPA served
# by NGINX, so these are BAKED IN AT BUILD TIME ($env/static/public) — they are
# build args, not runtime config. When building the image yourself (`just run-dev`
# / `run-prod`, or `docker compose up --build`) the values below are baked in.
# Local `just frontend-dev` / `pnpm build` read this file directly (the frontend
# env dir points at the repo root); real environment variables still win over
# these file values.
# =============================================================================
# Public-facing API base URL. Relative by default (`/api`): the SPA and API are
# served same-origin behind Caddy (which routes `/api*` to the backend), so a
# relative base resolves against whatever origin serves the app. This keeps the
# bundle domain-agnostic — the same build (and prebuilt GHCR image) works on any
# domain, no rebuild needed. In dev, vite proxies `/api` to the backend (see
# frontend/vite.config.ts). Only set an absolute URL if you deliberately serve
# the API on a DIFFERENT origin than the site (then also set
# WEB__CORS_ALLOW_ORIGINS above) — e.g. https://api.example.com.
PUBLIC_API_URL=/api
# Backend origin the vite dev `/api` proxy forwards to (default
# http://localhost:8000; the Docker dev overlay sets http://api:8000). Point
# this at your backend if you run it on a non-default WEB__PORT. Dev-only —
# the prod NGINX build has no proxy.
# VITE_API_PROXY_TARGET=http://localhost:8000
# VAPID public key for Web Push (must match PUSH__PUBLIC_KEY_PATH content).
# Filled automatically by `just bootstrap` when it generates the VAPID keys.
PUBLIC_VAPID_KEY=
# Yandex SmartCaptcha client key for the login captcha (leave empty to disable).
# Must be paired with the backend server key SMARTCAPTCHA__SERVER_KEY above.
PUBLIC_SMARTCAPTCHA_CLIENT_KEY=
# Sentry DSN for frontend error tracking (leave empty to disable).
# ENVIRONMENT tags events (production / staging / …); TRACES_SAMPLE_RATE is the
# perf-trace sample rate 0.0–1.0 — an explicit 0 turns tracing off, while an
# empty or malformed value falls back to 0.1.
PUBLIC_SENTRY_DSN=
PUBLIC_SENTRY_ENVIRONMENT=production
PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# Commit SHA of the build, shown (shortened) in the profile footer so a bug
# report names an exact bundle. Injected by the publish workflow; leave empty
# locally — the footer line is then hidden. The key itself must stay present:
# $env/static/public fails the build on an undeclared PUBLIC_* import.
PUBLIC_APP_VERSION=
# Source-map upload for the frontend build — target a Sentry SaaS or self-hosted
# GlitchTip instance. Build-time only: consumed by frontend/vite.config.ts, never
# inlined into the bundle (hence no PUBLIC_ prefix). URL/ORG/PROJECT must all be
# set AND DEBUG__SENTRY_AUTH_TOKEN (above) must be non-empty, otherwise the build
# skips the upload. There are no defaults on purpose — a hardcoded instance
# outlives the deployment it was written for, and the upload then fails against a
# dead host. SENTRY_URL is the instance base URL, e.g. https://sentry.io/ for SaaS.
# SENTRY_RELEASE names the release the maps are uploaded under and is injected
# into the bundle so reported events match; leave it empty to use the git commit
# SHA, which is what CI and local builds want.
SENTRY_URL=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_RELEASE=
