{
	"compilerOptions": {
		"target": "ES2023",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"moduleDetection": "force",
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"noEmit": true,
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noFallthroughCasesInSwitch": true,
		"types": ["vite/client", "unplugin-icons/types/vue"]
	},
	"include": ["src/**/*.ts", "src/**/*.vue", "vite.config.ts"],
	// The service worker is its own TypeScript project (src/service-worker/tsconfig.json):
	// it needs WebWorker globals instead of the DOM's, and the two can't share one project.
	"exclude": ["src/service-worker"]
}
