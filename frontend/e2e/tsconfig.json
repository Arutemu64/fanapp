{
	// Editor / type-checking config for the Playwright suite. It is NOT part of the
	// SvelteKit app project (which builds src/), so it lives here and Playwright is
	// pointed at it via `tsconfig` in playwright.config.ts. Type-only imports of the
	// generated API types are erased at runtime, so no path alias is needed. They
	// come from `types.gen`, not the barrel: the barrel re-exports the SDK, whose
	// client imports the app's runtime config and with it SvelteKit's `$app/*`
	// modules, which only the app project declares.
	"extends": "../tsconfig.json",
	"compilerOptions": {
		"types": ["node"],
		"allowJs": false,
		"checkJs": false
	},
	"include": ["**/*.ts", "../playwright.config.ts", "../playwright.gallery.config.ts"]
}
