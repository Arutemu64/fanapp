{
	"name": "fanapp-frontend",
	"private": true,
	"version": "0.0.0",
	"description": "Frontend for the FAN FAN convention companion web app: mobile-first Vue 3 PWA",
	"license": "MIT",
	"packageManager": "pnpm@12.3.4",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "vue-tsc --noEmit -p tsconfig.json && tsc -p src/service-worker",
		"format": "prettier --write .",
		"test": "vitest run",
		"lint": "pnpm run --parallel --no-bail \"/^lint:/\"",
		"lint:format": "prettier --check --cache .",
		"lint:eslint": "eslint --cache --cache-strategy content --cache-location .eslintcache .",
		"deadcode": "knip --no-exit-code",
		"generate-api": "openapi-ts",
		"generate-api:check": "openapi-ts && git diff --exit-code -- src/lib/api/generated",
		"e2e": "playwright test",
		"e2e:ui": "playwright test --ui",
		"e2e:report": "playwright show-report",
		"e2e:typecheck": "tsc -p e2e/tsconfig.json --noEmit"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@eslint/compat": "2.1.1",
		"@eslint/js": "10.0.1",
		"@hey-api/openapi-ts": "0.99.0",
		"@iconify-json/simple-icons": "1.2.98",
		"@internationalized/date": "^3.12.3",
		"@playwright/test": "1.63.0",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "26.5.1",
		"eslint": "10.10.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-perfectionist": "5.11.0",
		"globals": "17.12.0",
		"knip": "^6.34.0",
		"prettier": "3.9.9",
		"prettier-plugin-tailwindcss": "0.8.1",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"typescript-eslint": "8.70.0",
		"unplugin-icons": "24.0.0",
		"vite": "8.3.0",
		"vitest": "5.0.0",
		"workbox-core": "7.4.1",
		"workbox-expiration": "7.4.1",
		"workbox-precaching": "7.4.1",
		"workbox-routing": "7.4.1",
		"workbox-strategies": "7.4.1",
		"@vitejs/plugin-vue": "^6.0.9",
		"vue-tsc": "^3.3.12",
		"eslint-plugin-vue": "^10.11.1",
		"vue-eslint-parser": "^10.4.1",
		"vite-imagetools": "^12.0.1",
		"vite-plugin-pwa": "^2.0.0",
		"workbox-build": "7.4.1",
		"@sentry/vite-plugin": "^5.4.1",
		"class-variance-authority": "^0.7.1",
		"shadcn-vue": "^2.8.2"
	},
	"dependencies": {
		"@fontsource-variable/inter": "5.3.0",
		"@fontsource-variable/unbounded": "5.3.0",
		"@khmyznikov/pwa-install": "0.7.0",
		"@tanstack/query-async-storage-persister": "^5.104.1",
		"idb-keyval": "6.3.0",
		"photoswipe": "5.4.4",
		"vue": "^3.5.43",
		"vue-router": "^5.3.1",
		"pinia": "^4.0.3",
		"@vueuse/core": "^15.0.0",
		"@tanstack/vue-query": "^5.104.1",
		"@tanstack/query-persist-client-core": "^5.104.1",
		"@sentry/vue": "^11.4.0",
		"@lucide/vue": "^1.52.0",
		"reka-ui": "^2.11.0",
		"vue-sonner": "^2.0.9",
		"vue-input-otp": "^0.4.0",
		"tailwind-merge": "^3.6.0",
		"clsx": "^2.1.1",
		"tw-animate-css": "^1.4.0"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
