		"prettier-plugin-tailwindcss": "^0.7.2",
		"set-cookie-parser": "^3.1.0",
		"svelte": "^5.54.1",
		"svelte-check": "^4.4.5",
		"tailwindcss": "^4.2.2",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.57.1",
		"vite": "^7.3.1"
	},
	"dependencies": {
		"@popperjs/core": "^2.11.8",
		"@sveltejs/mcp": "^0.1.22",
		"@types/node": "^25.5.0",
		"es6-promise": "^4.2.8",
		"openapi-fetch": "^0.17.0",
		"tailwind-merge": "^3.5.0"
