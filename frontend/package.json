{
	"name": "fanapp-frontend",
	"private": true,
	"version": "0.0.0",
	"description": "Frontend for the FAN FAN convention companion web app: mobile-first SvelteKit PWA",
	"license": "MIT",
	"packageManager": "pnpm@12.10.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "pnpm run compile:i18n && svelte-kit sync || echo ''",
		"compile:i18n": "paraglide-js compile --silent --project ./project.inlang --outdir ./src/lib/paraglide --strategy baseLocale --emit-ts-declarations",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p src/service-worker",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"test": "vitest run",
		"lint": "pnpm run --parallel --no-bail \"/^lint:/\"",
		"lint:format": "prettier --check --cache .",
		"lint:eslint": "eslint --cache --cache-strategy content --cache-location .eslintcache .",
		"deadcode": "knip --no-exit-code",
		"generate-api": "openapi-ts",
		"generate-api:check": "openapi-ts && git diff --exit-code -- src/lib/api/generated",
		"e2e": "playwright test",
		"e2e:ui": "playwright test --ui",
		"e2e:report": "playwright show-report",
		"e2e:typecheck": "tsc -p e2e/tsconfig.json --noEmit"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
		"@eslint/js": "10.0.1",
		"@hey-api/openapi-ts": "0.99.0",
		"@iconify-json/simple-icons": "1.2.99",
		"@inlang/paraglide-js": "2.25.4",
		"@inlang/paraglide-js-svelte": "1.0.4",
		"@inlang/plugin-message-format": "4.4.0",
		"@internationalized/date": "^3.12.3",
		"@lucide/svelte": "^1.35.0",
		"@playwright/test": "1.64.0",
		"@sveltejs/adapter-static": "4.0.0",
		"@sveltejs/enhanced-img": "1.0.0",
		"@sveltejs/kit": "3.0.1",
		"@sveltejs/load-config": "0.2.3",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "26.6.4",
		"@vitest/eslint-plugin": "1.6.27",
		"bits-ui": "^2.19.0",
		"clsx": "^2.1.1",
		"eslint": "10.12.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-better-tailwindcss": "4.9.0",
		"eslint-plugin-perfectionist": "5.12.1",
		"eslint-plugin-playwright": "2.12.1",
		"eslint-plugin-svelte": "3.23.0",
		"globals": "17.13.0",
		"knip": "^6.34.0",
		"mdsvex": "0.12.8",
		"prettier": "3.9.9",
		"prettier-plugin-svelte": "4.1.1",
		"prettier-plugin-tailwindcss": "0.8.1",
		"shadcn-svelte": "^1.5.0",
		"svelte": "5.57.2",
		"svelte-check": "4.7.6",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.70.0",
		"unplugin-icons": "24.0.0",
		"vite": "8.3.3",
		"vitest": "5.0.3",
		"workbox-core": "7.4.1",
		"workbox-expiration": "7.4.1",
		"workbox-precaching": "7.4.1",
		"workbox-routing": "7.4.1",
		"workbox-strategies": "7.4.1"
	},
	"dependencies": {
		"@dicebear/core": "10.7.0",
		"@dicebear/styles": "10.6.0",
		"@fontsource-variable/inter": "5.3.0",
		"@fontsource-variable/unbounded": "5.3.0",
		"@khmyznikov/pwa-install": "0.7.0",
		"@sentry/sveltekit": "10.76.1",
		"@tanstack/query-async-storage-persister": "^5.104.1",
		"@tanstack/svelte-query": "^6.3.1",
		"@tanstack/svelte-query-persist-client": "^6.3.1",
		"idb-keyval": "6.3.0",
		"svelte-sonner": "^1.2.1"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
