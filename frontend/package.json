{
	"name": "fanapp",
	"private": true,
	"version": "0.0.1",
	"packageManager": "pnpm@10.15.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
