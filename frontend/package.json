		"prettier-plugin-tailwindcss": "^0.7.4",
		"svelte": "^5.56.2",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.60.1",
		"unplugin-icons": "^23.0.1",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@sentry/sveltekit": "^8.55.2",
		"openapi-fetch": "^0.17.0",
		"set-cookie-parser": "^3.1.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
