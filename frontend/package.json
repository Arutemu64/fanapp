{
	"name": "fanapp",
	"private": true,
	"version": "0.0.1",
	"packageManager": "pnpm@11.15.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check --cache . && eslint --cache --cache-location .eslintcache .",
		"generate-api": "node ./scripts/generate-api.mjs"
	},
	"devDependencies": {
		"@eslint/compat": "2.1.0",
		"@eslint/js": "10.0.1",
		"@iconify-json/simple-icons": "1.2.91",
		"@sveltejs/adapter-static": "3.0.10",
		"@sveltejs/kit": "2.69.3",
		"@sveltejs/vite-plugin-svelte": "7.2.0",
		"@tailwindcss/vite": "4.3.2",
		"@types/node": "26.1.1",
		"eslint": "10.7.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-perfectionist": "5.10.0",
		"eslint-plugin-svelte": "3.20.0",
		"flowbite": "4.0.2",
		"flowbite-svelte": "1.33.1",
		"flowbite-svelte-icons": "3.1.0",
		"globals": "17.7.0",
		"openapi-typescript": "7.13.0",
		"prettier": "3.9.5",
		"prettier-plugin-svelte": "4.1.1",
		"prettier-plugin-tailwindcss": "0.8.0",
		"svelte": "5.56.6",
		"svelte-check": "4.7.2",
		"svelte-turnstile": "0.11.0",
		"tailwindcss": "4.3.2",
		"typescript": "6.0.3",
		"typescript-eslint": "8.63.0",
		"unplugin-icons": "23.0.1",
		"vite": "8.1.5"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.2.8",
		"@fontsource-variable/unbounded": "^5.2.8",
		"@khmyznikov/pwa-install": "^0.6.4",
		"@sentry/sveltekit": "^10.65.0",
		"idb-keyval": "^6.3.0",
		"openapi-fetch": "^0.17.0"
	}
