{
	"name": "fanapp-frontend",
	"private": true,
	"version": "0.0.0",
	"description": "Frontend for the FAN FAN convention companion web app: mobile-first SvelteKit PWA",
	"license": "MIT",
	"packageManager": "pnpm@11.24.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"test": "vitest run",
		"lint": "prettier --check --cache . && eslint --cache --cache-location .eslintcache .",
		"generate-api": "node ./scripts/generate-api.mjs",
		"generate-api:check": "node ./scripts/generate-api.mjs --check"
	},
	"devDependencies": {
		"@eslint/compat": "2.1.0",
		"@eslint/js": "10.0.1",
		"@iconify-json/simple-icons": "1.2.94",
		"@internationalized/date": "^3.12.3",
		"@lucide/svelte": "^1.35.0",
		"@sveltejs/adapter-static": "3.0.10",
		"@sveltejs/enhanced-img": "0.11.0",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "7.3.0",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "26.4.1",
		"@vite-pwa/sveltekit": "1.1.0",
		"bits-ui": "^2.19.0",
		"clsx": "^2.1.1",
		"eslint": "10.9.1",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-perfectionist": "5.10.1",
		"eslint-plugin-svelte": "3.23.0",
		"globals": "17.11.0",
		"openapi-typescript": "7.13.0",
		"prettier": "3.9.6",
		"prettier-plugin-svelte": "4.1.1",
		"prettier-plugin-tailwindcss": "0.8.1",
		"shadcn-svelte": "^1.5.0",
		"svelte": "5.57.0",
		"svelte-check": "4.7.6",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.68.0",
		"unplugin-icons": "23.0.1",
		"vite": "8.2.2",
		"vitest": "4.1.11",
		"workbox-core": "7.4.1",
		"workbox-expiration": "7.4.1",
		"workbox-precaching": "7.4.1",
		"workbox-routing": "7.4.1",
		"workbox-strategies": "7.4.1"
	},
	"dependencies": {
		"@fontsource-variable/inter": "5.3.0",
		"@fontsource-variable/unbounded": "5.3.0",
		"@khmyznikov/pwa-install": "0.6.4",
		"@panzoom/panzoom": "4.6.2",
		"@sentry/sveltekit": "10.72.0",
		"idb-keyval": "6.3.0",
		"openapi-fetch": "0.17.0",
		"svelte-sonner": "^1.2.1"
	}
}
