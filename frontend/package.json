{
	"name": "fanapp-frontend",
	"private": true,
	"version": "0.0.0",
	"description": "Frontend for the FAN FAN convention companion web app: mobile-first SvelteKit PWA",
	"license": "MIT",
	"packageManager": "pnpm@11.17.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"test": "vitest run",
		"lint": "prettier --check --cache . && eslint --cache --cache-location .eslintcache .",
		"generate-api": "node ./scripts/generate-api.mjs",
		"generate-api:check": "node ./scripts/generate-api.mjs --check"
	},
	"devDependencies": {
		"@eslint/compat": "2.1.0",
		"@eslint/js": "10.0.1",
		"@iconify-json/simple-icons": "1.2.92",
		"@sveltejs/adapter-static": "3.0.10",
		"@sveltejs/kit": "2.70.1",
		"@sveltejs/vite-plugin-svelte": "7.2.0",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "26.1.2",
		"eslint": "10.8.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-perfectionist": "5.10.0",
		"eslint-plugin-svelte": "3.22.0",
		"flowbite": "4.0.2",
		"flowbite-svelte": "1.33.1",
		"flowbite-svelte-icons": "3.1.0",
		"globals": "17.8.0",
		"openapi-typescript": "7.13.0",
		"prettier": "3.9.6",
		"prettier-plugin-svelte": "4.1.1",
		"prettier-plugin-tailwindcss": "0.8.1",
		"svelte": "5.56.8",
		"svelte-check": "4.7.4",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"typescript-eslint": "8.65.0",
		"unplugin-icons": "23.0.1",
		"vite": "8.1.5",
		"vitest": "4.1.10"
	},
	"dependencies": {
		"@fontsource-variable/inter": "5.3.0",
		"@fontsource-variable/unbounded": "5.3.0",
		"@khmyznikov/pwa-install": "0.6.4",
		"@sentry/sveltekit": "10.68.0",
		"idb-keyval": "6.3.0",
		"openapi-fetch": "0.17.0"
	}
}
