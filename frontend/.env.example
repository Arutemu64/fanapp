# Local development only — not used by Docker.
# In production, these vars come from the root `.env` via docker-compose.
# Copy to `frontend/.env` and fill in values for local `just frontend-dev`.
PUBLIC_API_URL=http://localhost:8000
PRIVATE_API_URL=http://localhost:8000
PUBLIC_VAPID_KEY=
PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
