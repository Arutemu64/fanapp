# Local development only — not used by Docker.
# In production, these vars come from the root `.env` via docker-compose.
# Copy to `frontend/.env` and fill in values for local `just frontend-dev`.
# Relative `/api` base: vite proxies it to the backend (VITE_API_PROXY_TARGET,
# default http://localhost:8000) — see frontend/vite.config.ts.
PUBLIC_API_URL=/api
# Port the vite dev server listens on (default 3000). Override to dodge a
# collision; strictPort is on, so a taken port fails fast instead of drifting.
# FRONTEND_PORT=3000
# Backend origin the `/api` proxy forwards to (default http://localhost:8000).
# Point this at your backend if you run it on a non-default WEB__PORT.
# VITE_API_PROXY_TARGET=http://localhost:8000
PUBLIC_VAPID_KEY=
PUBLIC_SENTRY_DSN=
# Yandex SmartCaptcha client key for the login captcha (leave empty to disable).
PUBLIC_SMARTCAPTCHA_CLIENT_KEY=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
