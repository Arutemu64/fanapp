{# An event without a public number (a break) is announced by title alone. #}
{% macro event_number_prefix(number) -%}
{% if number is not none %}№{{ '%03d' % number }} {% endif %}
{%- endmacro -%}
{% if position_difference == 0 -%}
<b>Выступление {{ event_number_prefix(event_number) }}«{{ event_title }}» началось!</b>
{%- else -%}
До начала выступления <b>{{ event_number_prefix(event_number) }}«{{ event_title }}»</b> осталось <b>{{ position_difference }} {{ position_difference|plural('выступление', 'выступления', 'выступлений') }}</b>
{% if reason_msg %}
{{ reason_msg }}
{%- endif %}
{%- endif %}
