{% macro events_pluralize(count) -%}
{% if (count % 10 == 1) and (count % 100 != 11) -%}
выступление
{%- elif (2 <= count % 10 <= 4) and (count % 100 < 10 or count % 100 >= 20) -%}
выступления
{%- else -%}
выступлений
{%- endif %}
{%- endmacro %}

{% if queue_difference == 0 -%}
🔥 Выступление №{{ '%03d' % event_public_number }} «{{ event_title }}» началось!
{%- else -%}
{% set hours_diff = time_diff // 3600 -%}
{% set rounded_minutes = ((time_diff % 3600) / 60) | round -%}
{% if rounded_minutes == 60 -%}
{% set hours_diff = hours_diff + 1 -%}
{% set minutes_diff = 0 -%}
{% else -%}
{% set minutes_diff = rounded_minutes -%}
{% endif -%}
🚀 До начала выступления №{{ '%03d' % event_public_number }} «{{ event_title }}» осталось {{ queue_difference }} {{ events_pluralize(queue_difference) }} (примерно {{ '%01d'|format(hours_diff) }}:{{ '%02d'|format(minutes_diff) }} ч.)

{{ reason_msg }}
{%- endif %}
