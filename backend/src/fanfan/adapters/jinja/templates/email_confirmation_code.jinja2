{# HTML email with a large one-time code for email confirmation. #}
{% extends "_email_layout.jinja2" %}

{% set title = "Подтверждение почты" %}

{% block content %}
<p style="margin:0 0 16px; font-size:16px; line-height:24px; color:#374151;">
  {% if username %}Здравствуйте, <strong style="color:#111827;">{{ username }}</strong>!{% else %}Здравствуйте!{% endif %}
</p>
<p style="margin:0 0 24px; font-size:15px; line-height:24px; color:#4b5563;">
  Введите этот код в приложении ФАН ФАН, чтобы подтвердить вашу почту и завершить настройку учётной записи.
</p>

{# Confirmation code uses the primary (watermelon crimson) accent; login uses secondary teal. #}
<div
  style="margin:0 0 24px; padding:24px 20px; border-radius:12px; background-color:#fff1f5; border:1px solid #ffccd9; text-align:center;">
  <div
    style="margin:0 0 8px; font-size:13px; line-height:20px; font-weight:600; letter-spacing:0.08em; text-transform:uppercase; color:#b30f43;">
    Код подтверждения
  </div>
  <div style="font-family:'Unbounded', 'Inter', -apple-system, sans-serif; font-size:34px; line-height:40px; font-weight:700; letter-spacing:0.18em; margin-right:-0.18em; color:#d61450;">{{ confirmation_code }}</div>
</div>

<p style="margin:0 0 12px; font-size:14px; line-height:20px; color:#4b5563;">
  Код действует <strong>{{ expires_in_minutes }}</strong> минут. Никому не сообщайте его.
</p>

<p style="margin:0; font-size:13px; line-height:20px; color:#6b7280;">
  Если вы не запрашивали это письмо, просто проигнорируйте его.
</p>
{% endblock %}
