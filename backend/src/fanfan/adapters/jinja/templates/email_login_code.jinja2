{# HTML email with a large one-time code for sign-in. #}
{% extends "_email_layout.jinja2" %}

{% set title = "Вход в ФАН ФАН" %}

{% block content %}
<p style="margin:0 0 16px; font-size:16px; line-height:24px; color:#374151;">
  {% if username %}Привет, <strong style="color:#111827;">{{ username }}</strong>!{% else %}Привет!{% endif %}
</p>
<p style="margin:0 0 24px; font-size:15px; line-height:24px; color:#4b5563;">
  Введи этот код на экране входа, чтобы войти в приложение ФАН ФАН.
</p>

{# Login code uses the secondary (teal rind) accent; confirmation uses primary crimson. #}
<div
  style="margin:0 0 24px; padding:24px 20px; border-radius:12px; background-color:#ecfdff; border:1px solid #a3eef9; text-align:center;">
  <div
    style="margin:0 0 8px; font-size:13px; line-height:20px; font-weight:600; letter-spacing:0.08em; text-transform:uppercase; color:#0a6173;">
    Код входа
  </div>
  <div style="font-family:'Unbounded', 'Inter', -apple-system, sans-serif; font-size:34px; line-height:40px; font-weight:700; letter-spacing:0.18em; margin-right:-0.18em; color:#07788c;">{{ login_code }}</div>
</div>

<p style="margin:0 0 12px; font-size:14px; line-height:20px; color:#4b5563;">
  Код действует <strong>{{ expires_in_minutes }}</strong> минут. Никому не сообщай его.
</p>

<p style="margin:0; font-size:13px; line-height:20px; color:#6b7280;">
  Если это письмо пришло по ошибке, просто проигнорируй его.
</p>
{% endblock %}
