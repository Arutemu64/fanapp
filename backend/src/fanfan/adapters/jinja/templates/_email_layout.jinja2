{# Shared HTML email layout for auth emails. Mirrors the app's light card UI: white
   rounded card on a gray-50 page, watermelon-crimson wordmark, gray palette. Colors
   are the app's brand tokens (primary #d61450, secondary #0c9fb8) so email and app
   read as one product. Keep markup simple (tables + inline styles) for email client
   support. Web fonts are intentionally NOT linked: mail clients strip <link> fonts,
   so we rely on the inline system-sans fallback and carry brand voice via color and
   layout instead. #}
<!doctype html>
<html lang="ru">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="color-scheme" content="light only" />
  <meta name="supported-color-schemes" content="light only" />
  <title>{{ title }}</title>
</head>

<body style="margin:0; padding:0; background-color:#f9fafb; font-family:'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color:#111827; -webkit-font-smoothing:antialiased;">
  <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%"
    style="width:100%; border-collapse:collapse; background-color:#f9fafb;">
    <tr>
      <td style="padding:40px 16px;">
        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%"
          style="max-width:500px; margin:0 auto; border-collapse:collapse; background-color:#ffffff; border:1px solid #e5e7eb; border-radius:16px; box-shadow:0 1px 2px 0 rgba(0, 0, 0, 0.05); overflow:hidden;">
          <!-- Brand accent at the very top: watermelon crimson -> teal rind.
               background-color is the Outlook (no-gradient) fallback. -->
          <tr>
            <td height="4" style="height:4px; font-size:0; line-height:0; background:linear-gradient(90deg, #d61450, #0c9fb8); background-color:#d61450;">&nbsp;</td>
          </tr>
          <!-- Light header: crimson wordmark + Unbounded display title.
               primary-700 (#b30f43) keeps the small uppercase wordmark above 4.5:1 on white. -->
          <tr>
            <td style="padding:32px 32px 4px; background-color:#ffffff;">
              <div
                style="font-size:12px; line-height:16px; font-weight:700; letter-spacing:0.12em; text-transform:uppercase; color:#b30f43;">
                ФАН ФАН
              </div>
              <h1 style="margin:8px 0 0; font-family:'Unbounded', 'Inter', -apple-system, sans-serif; font-size:24px; line-height:32px; font-weight:700; color:#111827; letter-spacing:-0.01em;">
                {{ title }}
              </h1>
            </td>
          </tr>
          <!-- Main content area -->
          <tr>
            <td style="padding:20px 32px 28px;">
              {% block content %}{% endblock %}
            </td>
          </tr>
          <!-- Footer section -->
          <tr>
            <td style="padding:0 32px 28px; text-align:center; font-size:12px; line-height:18px; color:#6b7280;">
              <hr style="margin:0 0 20px; border:0; border-top:1px solid #e5e7eb;" />
              <div style="font-weight:600; color:#4b5563;">Приложение ФАН ФАН</div>
              <div style="margin-top:4px; font-size:12px; color:#6b7280;">
                Это автоматическое письмо, отвечать на него не нужно.
              </div>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>

</html>
