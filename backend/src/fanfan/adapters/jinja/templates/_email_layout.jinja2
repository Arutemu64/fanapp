{# Shared HTML layout for the auth (OTP) emails. Mirrors what a user sees at /login:
   the ФАН ФАН wordmark centred above a white rounded card on a gray-50 page, so the
   email and the app read as one product. Deliberately restrained like that screen —
   no gradients or tinted panels, one crimson accent on the wordmark, everything else
   ink and gray. Tables + inline styles for mail-client support. SVG marks and <link>
   web fonts are stripped by many clients, so the wordmark is styled text over the
   system-sans fallback and brand is carried by colour and card shape, not imagery.
   Light-only: the app has a dark theme, but one well-contrasted light email renders
   more predictably than trusting clients to honour dark-mode overrides. #}
<!doctype html>
<html lang="ru">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="color-scheme" content="light only" />
  <meta name="supported-color-schemes" content="light only" />
  <title>{{ title }}</title>
</head>

<body style="margin:0; padding:0; background-color:#f9fafb; font-family:'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color:#111827; -webkit-font-smoothing:antialiased;">
  {# Preheader: the inbox preview line. Held off-screen so it sets the preview (the code
     and its lifetime) without appearing in the email body. The zero-width spaces stop
     the client from pulling body copy in after it. #}
  <div style="display:none; max-height:0; overflow:hidden; opacity:0; mso-hide:all;">
    {% block preheader %}{% endblock %}
    &#8203;&#8203;&#8203;&#8203;&#8203;&#8203;&#8203;&#8203;&#8203;&#8203;
  </div>
  <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%"
    style="width:100%; border-collapse:collapse; background-color:#f9fafb;">
    <tr>
      <td style="padding:40px 16px;">
        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%"
          style="max-width:480px; margin:0 auto; border-collapse:collapse;">
          <!-- Brand wordmark above the card, as on the login screen. Crimson is the app's
               primary; it is the single accent in the whole email. -->
          <tr>
            <td style="padding:0 8px 20px; text-align:center;">
              <span
                style="font-family:'Unbounded', 'Inter', -apple-system, sans-serif; font-size:22px; line-height:28px; font-weight:800; letter-spacing:0.02em; color:#d61450;">ФАН&nbsp;ФАН</span>
            </td>
          </tr>
          <!-- The card: same white / rounded-2xl / hairline-border / soft-shadow as the
               app's login Card. -->
          <tr>
            <td
              style="padding:32px; background-color:#ffffff; border:1px solid #e5e7eb; border-radius:16px; box-shadow:0 1px 2px 0 rgba(0, 0, 0, 0.05);">
              <h1
                style="margin:0 0 20px; font-family:'Unbounded', 'Inter', -apple-system, sans-serif; font-size:22px; line-height:30px; font-weight:700; color:#111827; letter-spacing:-0.01em;">
                {{ title }}
              </h1>
              {% block content %}{% endblock %}
            </td>
          </tr>
          <!-- Footer: one muted line under the card, no divider. -->
          <tr>
            <td style="padding:20px 8px 0; text-align:center; font-size:12px; line-height:18px; color:#9ca3af;">
              Приложение ФАН ФАН · автоматическое письмо, отвечать на него не нужно
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>

</html>
