{# Shared HTML email layout for auth emails. Keep markup simple for better email client support. #}
<!doctype html>
<html lang="ru">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ title }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>

<body style="margin:0; padding:0; background-color:#f8fafc; font-family:'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color:#0f172a; -webkit-font-smoothing:antialiased;">
  <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%"
    style="width:100%; border-collapse:collapse; background-color:#f8fafc;">
    <tr>
      <td style="padding:40px 16px;">
        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%"
          style="max-width:500px; margin:0 auto; border-collapse:collapse; background-color:#ffffff; border:1px solid #e2e8f0; border-radius:20px; box-shadow:0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03); overflow:hidden;">
          <!-- Brand gradient border at the very top -->
          <tr>
            <td height="4" style="height:4px; font-size:0; line-height:0; background:linear-gradient(90deg, #fe795d, #0ea5e9); background-color:#fe795d;">&nbsp;</td>
          </tr>
          <!-- Dark premium header -->
          <tr>
            <td style="padding:32px 32px 24px; background-color:#0f172a; color:#ffffff;">
              <div
                style="font-size:12px; line-height:16px; font-weight:700; letter-spacing:0.12em; text-transform:uppercase; color:#fe795d;">
                ФАН ФАН
              </div>
              <h1 style="margin:8px 0 0; font-size:24px; line-height:32px; font-weight:700; color:#ffffff; letter-spacing:-0.02em;">
                {{ title }}
              </h1>
            </td>
          </tr>
          <!-- Main content area -->
          <tr>
            <td style="padding:32px 32px 28px;">
              {% block content %}{% endblock %}
            </td>
          </tr>
          <!-- Footer section -->
          <tr>
            <td style="padding:0 32px 24px; text-align:center; font-size:12px; line-height:18px; color:#94a3b8;">
              <hr style="margin:0 0 20px; border:0; border-top:1px solid #f1f5f9;" />
              <div style="font-weight:600; color:#64748b;">Помощник фестиваля ФАН ФАН</div>
              <div style="margin-top:4px; font-size:11px; color:#94a3b8; opacity:0.9;">
                Это автоматическое письмо, отвечать на него не нужно.
              </div>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>

</html>