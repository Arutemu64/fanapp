{% autoescape false %}
{% if event_number is not none %}
{% set label = '№%03d' % event_number %}
{% else %}
{% set label = '«' ~ event_title ~ '»' %}
{% endif %}
{% if change_type == 'set_as_current' and left_stage %}
Выступление {{ label }} больше не текущее
{% elif change_type == 'set_as_current' %}
Выступление {{ label }} началось
{% elif change_type == 'moved' %}
Выступление {{ label }} перенесено
{% elif change_type == 'skipped' %}
Выступление {{ label }} было снято
{% elif change_type == 'unskipped' %}
Выступление {{ label }} вернулось
{% endif %}
{% endautoescape %}
