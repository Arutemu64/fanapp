{
	servers {
        # Set trusted proxies so passing HTTPS handled correctly
		trusted_proxies static 100.64.0.0/10
	}
}

# The upstream ports below must match the host ports Compose publishes
# (API_PORT / FRONTEND_PORT in .env, default 8000 / 3000). If you override
# either var, update the matching reverse_proxy target here.
:80 {
    # Route all requests starting with /api to FastAPI
	handle_path /api* {
		reverse_proxy http://127.0.0.1:8000
	}

    # Route everything else to Svelte/Vite
	handle {
		reverse_proxy http://127.0.0.1:3000
	}
}
