# Normalize line endings: store LF in the repo, check out LF on every platform.
# Stops Windows autocrlf from producing CRLF that Prettier/ESLint then flag.
* text=auto eol=lf

# Binary files: never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.pdf binary
