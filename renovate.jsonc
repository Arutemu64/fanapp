{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":pinDevDependencies",
    ":semanticCommits",
    ":enablePreCommit",
    "helpers:pinGitHubActionDigestsToSemver",
    "abandonments:recommended",
    "customManagers:dockerfileVersions",
    "docker:pinDigests"
  ],
  "configMigration": true,
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/__fixtures__/**",
    ".agents/skills/**"
  ],
  "timezone": "Europe/Moscow",
  "schedule": ["* 0-5 * * 1"],
  "updateNotScheduled": false,
  "labels": ["dependencies"],
  "rangeStrategy": "bump",
  "minimumReleaseAge": "7 days",
  "osvVulnerabilityAlerts": true,
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": false,
    "schedule": ["* 0-5 * * 1"],
    "minimumReleaseAge": null
  },
  "packageRules": [
    {
      "description": "This is an application (frontend is private, backend is a deployed service — neither is published for others to install), so Renovate best practice is to pin runtime deps to exact versions rather than float SemVer ranges (https://docs.renovatebot.com/dependency-pinning/). :pinDevDependencies already pins frontend devDependencies; this rule extends exact pinning to the frontend runtime 'dependencies' that still carry '^' ranges. Scoped to frontend/package.json so it does not rewrite the backend's '>=' floors, which intentionally rely on uv.lock as the real pin. The global rangeStrategy stays 'bump'.",
      "matchFileNames": ["frontend/package.json"],
      "rangeStrategy": "pin"
    },
    {
      "description": "Auto-merge dev tooling (linters, formatters, type checkers, test libs) on minor/patch — these break loudly in CI, not silently in prod. Aged 14 days like every unreviewed merge (see the runtime rule below): dev tooling never ships, but it runs on developer machines and in CI, which is what the Nx and Shai-Hulud worms went after.",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "minimumReleaseAge": "14 days",
      "automerge": true
    },
    {
      "description": "Automerge stable runtime patches after 14 days on the frontend and 7 days on the backend, aligned with uv. Keep 0.x runtime releases on review PRs.",
      "matchDepTypes": ["dependencies", "project.dependencies"],
      "matchUpdateTypes": ["patch"],
      "matchCurrentVersion": "!/^0/",
      "minimumReleaseAge": "14 days",
      "automerge": true
    },
    {
      "description": "Review changes whose code or generated output ships to users, including service workers, translations and Markdown preprocessing.",
      "matchFileNames": ["frontend/package.json"],
      "matchPackageNames": [
        "svelte",
        "@sveltejs/**",
        "vite",
        "tailwindcss",
        "@tailwindcss/**",
        "bits-ui",
        "shadcn-svelte",
        "tailwind-variants",
        "tailwind-merge",
        "clsx",
        "mode-watcher",
        "tw-animate-css",
        "@lucide/svelte",
        "unplugin-icons",
        "@iconify-json/**",
        "workbox-*",
        "@inlang/**",
        "@internationalized/date",
        "mdsvex"
      ],
      "minimumReleaseAge": "7 days",
      "automerge": false
    },
    {
      "description": "Automerge backend dev-group tools on minor/patch updates. The pep621 rule keeps their release age aligned with uv.",
      "matchFileNames": ["backend/pyproject.toml"],
      "matchDepTypes": ["dependency-groups"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Keep backend updates on the same 7-day window as uv exclude-newer. A longer Renovate window can reject newer releases selected by uv while relocking.",
      "matchManagers": ["pep621"],
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Auto-merge GitHub Actions on minor/patch; majors still get a manual review PR. 'digest' and 'pin' ride along because helpers:pinGitHubActionDigestsToSemver re-pins by digest constantly, and pinning an action already in use to its current digest changes nothing.",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin"],
      "automerge": true
    },
    {
      "description": "Age automerged actions 14 days. Version-file inputs avoid duplicate runtime and package-manager pins.",
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["action", "workflow"],
      "minimumReleaseAge": "14 days"
    },
    {
      "description": "Auto-merge pre-commit hook bumps on minor/patch.",
      "matchManagers": ["pre-commit"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "minimumReleaseAge": "14 days"
    },
    {
      "description": "Keep exact uv pins together. The native Docker manager owns both GHCR tags and digests. GHCR has no release timestamp, so the entire group is review-only with no cooldown; CI rejects incomplete updates.",
      "groupName": "uv",
      "matchPackageNames": ["uv", "uv-build", "astral-sh/uv", "ghcr.io/astral-sh/uv"],
      "minimumReleaseAge": null,
      "automerge": false
    },
    {
      "description": "Shared pin (docs/dependencies.md): keep every Postgres image pin identical (docker-compose + the two Python literals) — a mismatched image risks false migration diffs. One grouped PR. postgres-backup-local's '18-alpine' tag must track the postgres major, so it rides in the same group.",
      "groupName": "postgres",
      "matchDepNames": ["postgres", "prodrigestivill/postgres-backup-local"]
    },
    {
      "description": "Keep the mise runtime and Docker image version together; CI reads mise.toml directly.",
      "groupName": "node",
      "matchDepNames": ["node"]
    },
    {
      "description": "Shared pin (docs/dependencies.md): keep the two *exact* Python pins identical — mise.toml (mise) and backend/.python-version (pyenv) — so one release does not arrive as two PRs settling on different versions. requires-python in backend/pyproject.toml (pep621) is matched too, but it is a compatibility floor, not an exact pin: the 'python floor' rule below freezes it at the minor, so it contributes no bump to this group and can never re-tighten onto a trailing .python-version whose datasource lags.",
      "groupName": "python",
      "matchDepNames": ["python"]
    },
    {
      "description": "Keep mise, packageManager and the annotated Dockerfile pin together; CI reads frontend/package.json directly.",
      "groupName": "pnpm",
      "matchDepNames": ["pnpm"]
    },
    {
      "description": "Shared pin (docs/dependencies.md): keep the hadolint binary pin identical across the pre-commit hook (.pre-commit-config.yaml rev) and mise.toml. Excludes hadolint/hadolint-action, a separate action version stream.",
      "groupName": "hadolint",
      "matchPackageNames": ["hadolint", "hadolint/hadolint"],
      "minimumReleaseAge": "14 days"
    },
    {
      "description": "Shared pin (docs/dependencies.md): keep the gitleaks pin identical across the pre-commit hook (.pre-commit-config.yaml rev) and GITLEAKS_VERSION in the CI 'secrets' job. Both read the same .gitleaks.toml, so a version skew would let the local hook and CI disagree about what counts as a secret — the one drift this pair must never develop.",
      "groupName": "gitleaks",
      "matchPackageNames": ["gitleaks/gitleaks"],
      "minimumReleaseAge": "14 days"
    },
    {
      "description": "Major runtime/image and framework bumps are review-only: no automerge, explicit label so they surface on the dashboard.",
      "matchUpdateTypes": ["major"],
      "matchPackageNames": [
        "fastapi",
        "pydantic",
        "sqlalchemy",
        "alembic",
        "faststream",
        "svelte",
        "@sveltejs/kit",
        "vite",
        "tailwindcss",
        "bits-ui",
        "shadcn-svelte",
        "postgres",
        "prodrigestivill/postgres-backup-local",
        "node",
        "python",
        "nats",
        "nginx",
        "debian"
      ],
      "automerge": false,
      "addLabels": ["major-review"]
    },
    {
      "description": "python floor: requires-python in backend/pyproject.toml is a compatibility floor, not a pin (https://packaging.python.org/en/latest/specifications/pyproject-toml/#requires-python) — it declares the minimum interpreter the code needs, so unlike the exact pins in mise.toml and backend/.python-version it must not chase every patch. The global rangeStrategy 'bump' would re-raise '>=3.14' to the latest patch on each release, which then makes a trailing .python-version — whose pyenv/docker datasource lags the CPython release the pep621 site reads — violate the floor and break `uv sync` in the image build (PR #565). 'replace' leaves the floor untouched while any 3.14.x satisfies it; raising it (dropping a minor) stays a deliberate human edit.",
      "matchManagers": ["pep621"],
      "matchFileNames": ["backend/pyproject.toml"],
      "matchDepNames": ["python"],
      "rangeStrategy": "replace"
    },
    {
      "description": "Renovate 44 requires Node ^24.11.0. Keep its validator runtime separate from the Node 26 application.",
      "matchFileNames": [".github/renovate/mise.toml"],
      "matchDepNames": ["node"],
      "groupName": "renovate validator runtime",
      "allowedVersions": "^24.11.0"
    }
  ],
  "customManagers": [
    {
      "description": "Shared pin (docs/dependencies.md): the gitleaks binary the CI 'secrets' job downloads, held in a single GITLEAKS_VERSION literal. The pre-commit manager already tracks the same tool through the `rev` in .pre-commit-config.yaml, but no built-in manager reads a version out of a workflow `env:` block, so without this the CI copy silently falls behind. extractVersion strips the tag's leading `v` because the download URL interpolates the bare version too. Feeds the 'gitleaks' group above.",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/ci\\.yml$/"],
      "matchStrings": ["GITLEAKS_VERSION: (?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"],
      "depNameTemplate": "gitleaks/gitleaks",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$",
      "versioningTemplate": "semver"
    },
    {
      "description": "Shared pin (docs/dependencies.md): Postgres image tag hard-coded as a Python string literal in the migration generator and the integration-test fixture (not visible to the docker-compose manager).",
      "customType": "regex",
      "managerFilePatterns": [
        "/^backend/scripts/generate_migration\\.py$/",
        "/^backend/tests/fixtures/db_provider\\.py$/"
      ],
      "matchStrings": [
        "postgres:(?<currentValue>[^\"@\\s]+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?\""
      ],
      "depNameTemplate": "postgres",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "autoReplaceStringTemplate": "postgres:{{{newValue}}}{{#if newDigest}}@{{{newDigest}}}{{/if}}\""
    },
    {
      "description": "Shared uv pin in backend/pyproject.toml [tool.uv] required-version. Feeds the uv group alongside the Docker builder and CI setup-uv pins.",
      "customType": "regex",
      "managerFilePatterns": ["/^backend/pyproject\\.toml$/"],
      "matchStrings": ["required-version = \"==(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""],
      "depNameTemplate": "uv",
      "datasourceTemplate": "pypi",
      "versioningTemplate": "pep440"
    }
  ]
}
