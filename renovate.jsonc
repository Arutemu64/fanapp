{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":pinDevDependencies",
    ":semanticCommits",
    ":enablePreCommit",
    "helpers:pinGitHubActionDigestsToSemver",
    "abandonments:recommended",
    "customManagers:dockerfileVersions"
  ],
  "configMigration": true,
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/__fixtures__/**",
    ".agents/skills/**"
  ],
  "timezone": "Europe/Moscow",
  "schedule": ["* 0-5 * * 1"],
  "updateNotScheduled": false,
  "labels": ["dependencies"],
  "rangeStrategy": "bump",
  "minimumReleaseAge": "7 days",
  "osvVulnerabilityAlerts": true,
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["* 0-5 * * 1"],
    "minimumReleaseAge": null
  },
  "packageRules": [
    {
      "description": "This is an application (frontend is private, backend is a deployed service — neither is published for others to install), so Renovate best practice is to pin runtime deps to exact versions rather than float SemVer ranges (https://docs.renovatebot.com/dependency-pinning/). :pinDevDependencies already pins frontend devDependencies; this rule extends exact pinning to the frontend runtime 'dependencies' that still carry '^' ranges. Scoped to frontend/package.json so it does not rewrite the backend's '>=' floors, which intentionally rely on uv.lock as the real pin. The global rangeStrategy stays 'bump'.",
      "matchFileNames": ["frontend/package.json"],
      "rangeStrategy": "pin"
    },
    {
      "description": "Auto-merge dev tooling (linters, formatters, type checkers, test libs) on minor/patch — these break loudly in CI, not silently in prod. Aged 14 days like every unreviewed merge (see the runtime rule below): dev tooling never ships, but it runs on developer machines and in CI, which is what the Nx and Shai-Hulud worms went after.",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "minimumReleaseAge": "14 days",
      "automerge": true
    },
    {
      "description": "Auto-merge patch bumps of runtime deps (frontend 'dependencies', backend [project] dependencies) after 14 days — the age Renovate recommends once third-party deps automerge, to give registries time to pull a malicious release (https://docs.renovatebot.com/upgrade-best-practices/). The backend half is held back to 7 days by the pep621 rule below. 0.x packages (fastapi, adaptix, …) are excluded because any 0.x release may break (https://docs.renovatebot.com/key-concepts/automerge/); a regex matchCurrentVersion compares the locked version, so this holds for the backend's '>=' floors too. Sits above the shipped-bundle carve-out so that rule still keeps its runtime members (clsx, tailwind-merge, …) on review PRs. Database and service images are untouched: they are docker deps, not these depTypes.",
      "matchDepTypes": ["dependencies", "project.dependencies"],
      "matchUpdateTypes": ["patch"],
      "matchCurrentVersion": "!/^0/",
      "minimumReleaseAge": "14 days",
      "automerge": true
    },
    {
      "description": "Carve-out from the rule above: SvelteKit convention puts the framework, bundler, CSS engine and the shadcn-svelte component substrate in devDependencies, but their output ships in the bundle, so 'breaks loudly in CI' does not hold for them — a Tailwind or bits-ui/shadcn minor can move the layout, and an icon-pack minor can redraw a glyph, with every gate green. shadcn-svelte components are vendored as source, but the CLI's tailwind.css and the class-generation utilities (tailwind-variants, tailwind-merge, clsx) plus tw-animate-css and mode-watcher still ship. These get a review PR like any other shipped dependency. Everything else in devDependencies (eslint, prettier, typescript, svelte-check, vitest, @hey-api/openapi-ts) keeps automerging.",
      "matchFileNames": ["frontend/package.json"],
      "matchPackageNames": [
        "svelte",
        "@sveltejs/**",
        "vite",
        "tailwindcss",
        "@tailwindcss/**",
        "bits-ui",
        "shadcn-svelte",
        "tailwind-variants",
        "tailwind-merge",
        "clsx",
        "mode-watcher",
        "tw-animate-css",
        "@lucide/svelte",
        "unplugin-icons",
        "@iconify-json/**"
      ],
      "minimumReleaseAge": "7 days",
      "automerge": false
    },
    {
      "description": "Auto-merge backend dev-group tools (ruff, ty, pytest, import-linter, etc.) on minor/patch. The depType is 'dependency-groups' — the name Renovate's pep621 manager gives the whole PEP 735 [dependency-groups] table (https://docs.renovatebot.com/modules/manager/pep621/) — not the group's own name 'dev', which never matched.",
      "matchFileNames": ["backend/pyproject.toml"],
      "matchDepTypes": ["dependency-groups"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Backend deps keep the global 7 days even where they automerge, overriding the 14 days on the runtime rule above. Renovate bumps a '>=' floor to the newest release past its age, then uv relocks under its own exclude-newer (backend/pyproject.toml, 7 days); with Renovate at 14, uv can lock a newer 8–13-day-old release, which Renovate rejects as a pending version and the PR sticks on renovate/artifacts (the #310 failure). Raising exclude-newer to 14 instead would hold every backend resolution, reviewed PRs and local `uv add` included, to 14 days.",
      "matchManagers": ["pep621"],
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Auto-merge GitHub Actions on minor/patch; majors still get a manual review PR. 'digest' and 'pin' ride along because helpers:pinGitHubActionDigestsToSemver re-pins by digest constantly, and pinning an action already in use to its current digest changes nothing.",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin"],
      "automerge": true
    },
    {
      "description": "Age automerged actions 14 days, like the other unreviewed merges: an action runs in CI with the workflow's token, the tj-actions attack's target. Scoped to the 'action'/'workflow' depTypes so it skips the setup-uv/setup-node/pnpm version inputs ('uses-with'), which belong to the uv, node and pnpm shared-pin groups — aging them longer than their mise and pyproject sites would split each group across two target versions. pre-commit hooks stay at 7 days for the same reason: gitleaks and hadolint are shared pins too.",
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["action", "workflow"],
      "minimumReleaseAge": "14 days"
    },
    {
      "description": "Auto-merge pre-commit hook bumps on minor/patch.",
      "matchManagers": ["pre-commit"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Shared pin (docs/dependencies.md): keep every uv pin identical. Groups the PyPI pin (setup.sh, pyproject [tool.uv]), the setup-uv 'version' input in CI and the Docker builder image (both read as 'astral-sh/uv' GitHub releases — see the rule below), and the mise toolchain pin into one PR so they always bump together. uv_build rides along: Astral releases it from the same repo under the same version numbers, so with rangeStrategy 'bump' its floor in [build-system] requires would otherwise move in a PR of its own and leave the two disagreeing. It is matched as 'uv-build': the pep621 manager PEP 503-normalizes packageName (normalizePythonDepName in Renovate), so the 'uv_build' spelling in pyproject never matched and the floor got a renovate/uv_build-0.x branch of its own.",
      "groupName": "uv",
      "matchPackageNames": ["uv", "astral-sh/uv", "uv-build"]
    },
    {
      "description": "The backend/Dockerfile builder image is tracked by the 'astral-sh/uv' regex manager below, not by the dockerfile manager. GHCR returns no release timestamps (https://docs.renovatebot.com/key-concepts/minimum-release-age/), and since Renovate 42 the default minimumReleaseAgeBehaviour 'timestamp-required' holds such an update forever, so the uv group shipped without the image and its bumped [tool.uv] required-version broke the image build (PR #643). Turning on 'timestamp-optional' for the image instead is no fix: with no age check it jumps to the newest tag while the aged sites stay a release behind, the same mismatch the other way round.",
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["ghcr.io/astral-sh/uv"],
      "enabled": false
    },
    {
      "description": "Shared pin (docs/dependencies.md): keep every Postgres image pin identical (docker-compose + the two Python literals) — a mismatched image risks false migration diffs. One grouped PR. postgres-backup-local's '18-alpine' tag must track the postgres major, so it rides in the same group.",
      "groupName": "postgres",
      "matchDepNames": ["postgres", "prodrigestivill/postgres-backup-local"]
    },
    {
      "description": "Group Node runtime pins (mise, frontend Dockerfile, the setup-node 'node-version' input in CI) so the runtime version bumps in a single reviewable PR.",
      "groupName": "node",
      "matchDepNames": ["node"]
    },
    {
      "description": "Shared pin (docs/dependencies.md): keep the two *exact* Python pins identical — mise.toml (mise) and backend/.python-version (pyenv) — so one release does not arrive as two PRs settling on different versions. requires-python in backend/pyproject.toml (pep621) is matched too, but it is a compatibility floor, not an exact pin: the 'python floor' rule below freezes it at the minor, so it contributes no bump to this group and can never re-tighten onto a trailing .python-version whose datasource lags.",
      "groupName": "python",
      "matchDepNames": ["python"]
    },
    {
      "description": "Shared pin (docs/dependencies.md): keep every pnpm binary pin identical — mise.toml, package.json 'packageManager', and the 'version' input to pnpm/action-setup in CI, which the github-actions manager extracts natively as 'pnpm'. One grouped PR. Matching by depName excludes the pnpm/action-setup action itself, a separate version stream.",
      "groupName": "pnpm",
      "matchDepNames": ["pnpm"]
    },
    {
      "description": "Shared pin (docs/dependencies.md): keep the hadolint binary pin identical across the pre-commit hook (.pre-commit-config.yaml rev) and mise.toml. Excludes hadolint/hadolint-action, a separate action version stream.",
      "groupName": "hadolint",
      "matchPackageNames": ["hadolint", "hadolint/hadolint"]
    },
    {
      "description": "Shared pin (docs/dependencies.md): keep the gitleaks pin identical across the pre-commit hook (.pre-commit-config.yaml rev) and GITLEAKS_VERSION in the CI 'secrets' job. Both read the same .gitleaks.toml, so a version skew would let the local hook and CI disagree about what counts as a secret — the one drift this pair must never develop.",
      "groupName": "gitleaks",
      "matchPackageNames": ["gitleaks/gitleaks"]
    },
    {
      "description": "Major runtime/image and framework bumps are review-only: no automerge, explicit label so they surface on the dashboard.",
      "matchUpdateTypes": ["major"],
      "matchPackageNames": [
        "fastapi",
        "pydantic",
        "sqlalchemy",
        "alembic",
        "faststream",
        "svelte",
        "@sveltejs/kit",
        "vite",
        "tailwindcss",
        "bits-ui",
        "shadcn-svelte",
        "postgres",
        "prodrigestivill/postgres-backup-local",
        "node",
        "python",
        "nats",
        "nginx",
        "debian"
      ],
      "automerge": false,
      "addLabels": ["major-review"]
    },
    {
      "description": "python floor: requires-python in backend/pyproject.toml is a compatibility floor, not a pin (https://packaging.python.org/en/latest/specifications/pyproject-toml/#requires-python) — it declares the minimum interpreter the code needs, so unlike the exact pins in mise.toml and backend/.python-version it must not chase every patch. The global rangeStrategy 'bump' would re-raise '>=3.14' to the latest patch on each release, which then makes a trailing .python-version — whose pyenv/docker datasource lags the CPython release the pep621 site reads — violate the floor and break `uv sync` in the image build (PR #565). 'replace' leaves the floor untouched while any 3.14.x satisfies it; raising it (dropping a minor) stays a deliberate human edit.",
      "matchManagers": ["pep621"],
      "matchFileNames": ["backend/pyproject.toml"],
      "matchDepNames": ["python"],
      "rangeStrategy": "replace"
    }
  ],
  "customManagers": [
    {
      "description": "Shared pin (docs/dependencies.md): the gitleaks binary the CI 'secrets' job downloads, held in a single GITLEAKS_VERSION literal. The pre-commit manager already tracks the same tool through the `rev` in .pre-commit-config.yaml, but no built-in manager reads a version out of a workflow `env:` block, so without this the CI copy silently falls behind. extractVersion strips the tag's leading `v` because the download URL interpolates the bare version too. Feeds the 'gitleaks' group above.",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/ci\\.yml$/"],
      "matchStrings": ["GITLEAKS_VERSION: (?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"],
      "depNameTemplate": "gitleaks/gitleaks",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$",
      "versioningTemplate": "semver"
    },
    {
      "description": "Shared pin (docs/dependencies.md): Postgres image tag hard-coded as a Python string literal in the migration generator and the integration-test fixture (not visible to the docker-compose manager).",
      "customType": "regex",
      "managerFilePatterns": [
        "/^backend/scripts/generate_migration\\.py$/",
        "/^backend/tests/fixtures/db_provider\\.py$/"
      ],
      "matchStrings": ["postgres:(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "postgres",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "description": "Shared uv pin in backend/pyproject.toml [tool.uv] required-version. Feeds the uv group alongside the Docker builder and CI setup-uv pins.",
      "customType": "regex",
      "managerFilePatterns": [
        "/^backend/pyproject\\.toml$/"
      ],
      "matchStrings": [
        "required-version = \"==(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""
      ],
      "depNameTemplate": "uv",
      "datasourceTemplate": "pypi",
      "versioningTemplate": "pep440"
    },
    {
      "description": "Shared pin (docs/dependencies.md): the uv version in the backend/Dockerfile builder tag (ghcr.io/astral-sh/uv:X.Y.Z or X.Y.Z-<base>, in a FROM or a COPY --from; the match stops at the version, so switching the base variant or to uv's documented COPY --from install keeps the pin tracked), read from GitHub releases rather than the GHCR tag list so minimumReleaseAge can age it (see the dockerfile disable rule above). Datasource, packageName and versioning mirror how the github-actions manager reads the setup-uv input (known-actions/github-releases.ts in Renovate), so the two sites always agree on the target version. Feeds the 'uv' group above.",
      "customType": "regex",
      "managerFilePatterns": ["/^backend/Dockerfile$/"],
      "matchStrings": ["ghcr\\.io/astral-sh/uv:(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)[-\\s]"],
      "depNameTemplate": "astral-sh/uv",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "npm"
    }
  ]
}
